# Elastic Beanstalk configuration for the FastTag Node.js backend.
#
# The app is COMPILED BEFORE DEPLOY (locally or in CI) and the compiled
# `dist/` is shipped inside the bundle. The server therefore only installs
# runtime dependencies and runs `npm start` -> node dist/index.js, defined by
# the Procfile. No TypeScript toolchain is needed on the instance.
#
# NODE_ENV=production also makes dotenv/loadConfig skip reading any .env file;
# all real configuration comes from EB environment properties.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
